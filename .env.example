# Copy to `.env` for local dev. Never commit real secrets.
# Docs: docs/ENV-VARIABLES.md

# Local default: JSON file store (no native SQLite). Leave DATABASE_URL empty.
OPR_DIRECTORY_DATABASE_URL=
OPR_DIRECTORY_DATABASE_AUTH_TOKEN=
OPR_DIRECTORY_JSON_PATH=./.data/catalog.json

# Optional Turso (remote HTTP only — libsql:// or https://). Do not use file: URLs.
# OPR_DIRECTORY_DATABASE_URL=libsql://your-db.turso.io
# OPR_DIRECTORY_DATABASE_AUTH_TOKEN=

OPR_DIRECTORY_ADMIN_TOKEN=
OPR_DIRECTORY_PUBLIC_ORIGIN=http://localhost:3000
OPR_DIRECTORY_NITRO_PRESET=
